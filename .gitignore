# Coverage profiles
coverage.out
coverage.html

# Load-test output (profiles, EXPLAIN captures) from stress_saas_test.go
stress-out/

# Binaries `go build ./...` drops next to their main package
/cmd/flexitype/flexitype
/examples/catalog/consumer/consumer
/examples/marketplace/platform/platform
/examples/marketplace/storefront/storefront

# TypeScript incremental build state — regenerated by every local build
web/tsconfig.tsbuildinfo

# TypeScript client build output and dependencies. The generated API types in
# client-ts/src/generated are checked in on purpose: a test regenerates them
# and fails when they are stale.
client-ts/node_modules/
client-ts/dist/

# Marketplace example front ends: dependencies and build output. The lockfiles
# are checked in, so `npm ci` is reproducible.
examples/marketplace/console/node_modules/
examples/marketplace/console/dist/
examples/marketplace/shop/node_modules/
examples/marketplace/shop/dist/
examples/marketplace/console/tsconfig.tsbuildinfo
examples/marketplace/shop/tsconfig.tsbuildinfo

# Kitchen example console: dependencies and build output. The lockfile is
