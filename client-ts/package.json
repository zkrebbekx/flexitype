{
  "name": "@flexitype/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client and React hooks for the flexitype REST API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "generate": "openapi-typescript ../api/openapi.yaml --output src/generated/openapi.ts --root-types --alphabetize",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.60.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.0",
    "happy-dom": "^20.11.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
